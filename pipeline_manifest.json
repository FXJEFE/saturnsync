{
  "venv_name": ".venv",
  "venv_dir": ".venv",
  "python": "3.8.10",
  "default_mode": "dry-run",
  "project_root_env": "FXJEFE_PROJECT_DIR",
  "stages": [
    {"group": "project", "script": "path_validate.py", "required": true},
    {"group": "project", "script": "validate_config.py", "required": true},
    {"group": "project", "script": "ftmo_rules.py", "required": true},
    {"group": "mt5_health", "script": "mt5_health.py", "required": true},
    {"group": "data", "script": "mt5_data_sync.py", "required": true},
    {"group": "data", "script": "mt5_generate_features.py", "required": true},
    {"group": "data", "script": "mt5_generate_crypto_features.py", "required": true},
    {"group": "data", "script": "validate_data.py", "required": true},
    {"group": "data", "script": "Load_and_Process.py", "required": true},
    {"group": "data", "script": "fix_csv.py", "required": true},
    {"group": "data", "script": "fix_csv_encoding.py", "required": true},
    {"group": "data", "script": "adjust_headers.py", "required": true},
    {"group": "data", "script": "convert_encoding.py", "required": true},
    {"group": "features", "script": "generate_training_data.py", "required": true},
    {"group": "features", "script": "generate_labels.py", "required": true},
    {"group": "features", "script": "generate_new_csv.py", "required": true},
    {"group": "features", "script": "clean_training_data.py", "required": true},
    {"group": "model", "script": "train_models.py", "required": true},
    {"group": "model", "script": "feature_engineering.py", "required": true},
    {"group": "model", "script": "check_model_features.py", "required": true},
    {"group": "model", "script": "full_pipeline.py", "required": true},
    {"group": "model", "script": "model_deploy.py", "required": true},
    {"group": "signals", "script": "ensemble_predictions.py", "required": true},
    {"group": "signals", "script": "generate_signals_with_xgboost.py", "required": true},
    {"group": "signals", "script": "get_lstm_prediction.py", "required": true},
    {"group": "signals", "script": "signal_processor.py", "required": true},
    {"group": "signals", "script": "signal_gate.py", "required": true},
    {"group": "signals", "script": "mt5_signal_script.py", "required": true},
    {"group": "ftmo_risk_gate", "script": "risk_management.py", "required": true},
    {"group": "execution", "script": "process_trades.py", "required": true},
    {"group": "monitoring", "script": "merge_datasets.py", "required": true},
    {"group": "monitoring", "script": "analyze_outcomes.py", "required": true},
    {"group": "monitoring", "script": "update_database.py", "required": true},
    {"group": "monitoring", "script": "check_integrity.py", "required": true},
    {"group": "monitoring", "script": "check_labels.py", "required": true},
    {"group": "monitoring", "script": "log_summary.py", "required": true}
  ],
  "note": "Order is enforced by run_pipeline.py. Paper mode is the default. FTMO limits come only from the rules file."
}
